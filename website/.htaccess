# ---------------------------------------------------------------------------
# Servereinstellungen fuer den echten Webserver (Apache, z. B. All-Inkl).
# Auf der GitHub-Vorschau wird diese Datei ignoriert - sie wirkt erst,
# wenn die Seite beim Hoster liegt.
#
# Domain: www.boesing-dentallabor.de (bei All-Inkl registriert am 01.10.2026)
# ---------------------------------------------------------------------------

RewriteEngine On

# --- Uebergangsadresse des Hosters nicht umleiten -------------------------
# Vor dem Domain-Umzug ist die Seite nur unter der Adresse
# <domain>.<konto>.kasserver.com erreichbar. Ohne diese Ausnahme wuerde die
# Umleitung darunter jeden Aufruf sofort wieder auf die ALTE Seite schicken,
# und der Test vor dem Livegang waere unmoeglich.
# Die Regel bleibt auch nach dem Livegang stehen: sie stoert nicht und
# rettet den naechsten Test.
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# --- Immer https und immer www -------------------------------------------
# Greift nur fuer boesing-dentallabor.de. So stoert die Regel weder die
# Uebergangsadresse des Hosters noch einen spaeteren Test, und fuer jede
# andere Adresse (z. B. falls eine zweite Domain dazukommt) passiert nichts.
RewriteCond %{HTTP_HOST} boesing-dentallabor\.de$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^boesing-dentallabor\.de$ [NC]
RewriteRule ^(.*)$ https://www.boesing-dentallabor.de/$1 [R=301,L]

ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  # HTML nie zwischenspeichern: sonst sehen Besucher (und wir beim
  # Testen) nach einer Aenderung stundenlang die alte Seite.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
